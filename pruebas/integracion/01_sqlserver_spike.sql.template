USE joseph_fdw_spike;
GO
CREATE TABLE dbo.facturacion_spike (
    id_paciente BIGINT NOT NULL,
    codigo_region CHAR(2) NOT NULL,
    nombre_aseguradora NVARCHAR(100) NOT NULL,
    estado_cobertura NVARCHAR(20) NOT NULL,
    estado_facturacion NVARCHAR(20) NOT NULL,
    total_facturado_crc DECIMAL(12,2) NOT NULL,
    fecha_actualizacion DATETIMEOFFSET(0) NOT NULL,
    CONSTRAINT PK_facturacion_spike PRIMARY KEY (id_paciente, codigo_region)
);
