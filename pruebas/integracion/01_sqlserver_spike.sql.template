CREATE VIEW dbo.vw_estado_facturacion AS
SELECT id_paciente, codigo_region, nombre_aseguradora, estado_cobertura,
       estado_facturacion, total_facturado_crc, fecha_actualizacion
FROM dbo.facturacion_spike;
GO
-- Vista adicional exclusivamente para probar table_name sin conversión implícita DATETIMEOFFSET.
CREATE VIEW dbo.vw_estado_tabla_spike AS
SELECT id_paciente, codigo_region, nombre_aseguradora, estado_cobertura,
       estado_facturacion, total_facturado_crc,
       CONVERT(varchar(40), fecha_actualizacion, 127) AS fecha_actualizacion
FROM dbo.facturacion_spike;
GO
